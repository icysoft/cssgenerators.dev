---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  datePublished: string;
  dateModified?: string;
  readingTime?: string;
  schema?: object;
}

const { title, description, canonical, datePublished, dateModified, readingTime, schema } = Astro.props;
const siteUrl = 'https://cssgenerators.dev';

const dateDisplay = new Date(datePublished).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Header />
  <main>
    <article style="max-width:780px;margin:0 auto;padding:56px 40px 96px">
      <nav style="font:400 13px/1 Inter;color:#6b6b7b;margin-bottom:32px">
        <a href="/" style="color:#8a8a9a;text-decoration:none">Tools</a>
        <span style="margin:0 8px;color:#3a3a4a">›</span>
        <a href="/blog" style="color:#8a8a9a;text-decoration:none">Blog</a>
        <span style="margin:0 8px;color:#3a3a4a">›</span>
        <span style="color:#e6e6ee;max-width:260px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:bottom">{title.split(' — ')[0]}</span>
      </nav>

      <header style="margin-bottom:48px;border-bottom:1px solid #1c1c26;padding-bottom:32px">
        <h1 style="font:800 38px/1.1 Inter;color:#f2f2f7;margin:0 0 16px;letter-spacing:-0.025em">{title.split(' — ')[0]}</h1>
        <p style="font:400 17px/1.55 Inter;color:#9b9bab;margin:0 0 20px;max-width:640px">{description}</p>
        <div style="display:flex;align-items:center;gap:20px;font:400 13px/1 Inter;color:#6b6b7b">
          <span>By <span style="color:#8a8a9a">Dinno SAS</span></span>
          <span style="color:#2a2a38">·</span>
          <time datetime={datePublished} style="color:#8a8a9a">{dateDisplay}</time>
          {readingTime && <>
            <span style="color:#2a2a38">·</span>
            <span style="color:#8a8a9a">{readingTime} read</span>
          </>}
        </div>
      </header>

      <div class="blog-content">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .blog-content h2 {
    font: 700 24px/1.25 Inter;
    color: #f2f2f7;
    margin: 48px 0 14px;
    letter-spacing: -0.015em;
  }
  .blog-content h3 {
    font: 600 18px/1.35 Inter;
    color: #e6e6ee;
    margin: 32px 0 10px;
    letter-spacing: -0.01em;
  }
  .blog-content h4 {
    font: 600 15px/1.4 Inter;
    color: #c0c0d0;
    margin: 24px 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 12px;
  }
  .blog-content p {
    font: 400 16px/1.7 Inter;
    color: #9b9bab;
    margin: 0 0 18px;
  }
  .blog-content a {
    color: #818cf8;
    text-decoration: none;
    border-bottom: 1px solid rgba(129,140,248,.3);
  }
  .blog-content a:hover {
    color: #a5b4fc;
    border-bottom-color: rgba(165,180,252,.5);
  }
  .blog-content strong {
    color: #e6e6ee;
    font-weight: 600;
  }
  .blog-content code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13.5px;
    background: #1a1a24;
    padding: 2px 7px;
    border-radius: 5px;
    color: #a5b4fc;
  }
  .blog-content pre {
    background: #0d0d12;
    border: 1px solid #1e1e2e;
    border-radius: 10px;
    padding: 20px 24px;
    overflow-x: auto;
    margin: 24px 0;
  }
  .blog-content pre code {
    background: none;
    padding: 0;
    font-size: 13.5px;
    color: #c0c0d0;
    line-height: 1.7;
  }
  .blog-content ul, .blog-content ol {
    padding-left: 22px;
    margin: 0 0 18px;
  }
  .blog-content li {
    font: 400 16px/1.7 Inter;
    color: #9b9bab;
    margin-bottom: 6px;
  }
  .blog-content .demo {
    background: #0d0d12;
    border: 1px solid #1e1e2e;
    border-radius: 12px;
    padding: 32px;
    margin: 28px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: center;
  }
  .blog-content .demo-label {
    font: 500 11px/1 'JetBrains Mono', monospace;
    color: #4a4a5a;
    text-align: center;
    margin-top: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .blog-content .demo-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .blog-content .callout {
    background: #131320;
    border-left: 3px solid #6366f1;
    border-radius: 0 8px 8px 0;
    padding: 16px 20px;
    margin: 24px 0;
  }
  .blog-content .callout p {
    margin: 0;
    font-size: 15px;
  }
  .blog-content .tool-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1px solid #2a2a38;
    border-radius: 8px;
    background: #16161e;
    color: #c0c0d0;
    font: 500 13.5px/1 Inter;
    text-decoration: none;
    border-bottom: none;
    margin: 4px 0;
    transition: border-color 0.15s;
  }
  .blog-content .tool-cta:hover {
    border-color: #6366f1;
    color: #e6e6ee;
  }
  .blog-content .sources {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid #1c1c26;
  }
  .blog-content .sources h4 {
    font: 600 12px/1 Inter;
    color: #4a4a5a;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }
  .blog-content .sources ul {
    list-style: none;
    padding: 0;
  }
  .blog-content .sources li {
    font-size: 13px;
    color: #6b6b7b;
    margin-bottom: 6px;
  }
</style>
