---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://cssgenerators.dev';
---
<Layout
  title="Terms of Use — CSS Generators | cssgenerators.dev"
  description="Terms of use for cssgenerators.dev. All generated CSS is free to use in any project, commercial or personal, with no attribution required."
  canonical={`${siteUrl}/terms`}
  robots="index, follow"
>
  <Header />

  <main style="max-width:760px;margin:0 auto;padding:64px 40px 80px">
    <nav style="font:400 13px/1 Inter;color:#6b6b7b;margin-bottom:32px">
      <a href="/" style="color:#8a8a9a;text-decoration:none">Tools</a>
      <span style="margin:0 8px;color:#3a3a4a">›</span>
      <span style="color:#e6e6ee">Terms of Use</span>
    </nav>

    <h1 style="font:800 38px/1.1 Inter;color:#f2f2f7;margin:0 0 12px;letter-spacing:-0.02em">Terms of Use</h1>
    <p style="font:400 13px/1 Inter;color:#6b6b7b;margin:0 0 48px;border-bottom:1px solid #1c1c26;padding-bottom:48px">Last updated: June 2026</p>

    <div class="seo-content">
      <h2>Acceptance</h2>
      <p>
        By using cssgenerators.dev, you agree to these terms. The site is operated by <strong style="color:#e6e6ee">Dinno SAS</strong>
        (SIREN 812225373). If you do not agree, please stop using the site.
      </p>

      <h2>License on generated CSS</h2>
      <p>
        All CSS code generated by the tools on this site is <strong style="color:#e6e6ee">free to use without restriction</strong>.
        You may use, copy, modify, and distribute generated CSS in personal or commercial projects with no attribution required.
      </p>

      <h2>Use of the site</h2>
      <p>
        You may use the site for any lawful purpose. You may not attempt to scrape the site in a way that disrupts service,
        reverse-engineer the tools for commercial resale, or misrepresent the origin of the tools.
      </p>

      <h2>Disclaimer</h2>
      <p>
        The tools are provided "as is" without warranty of any kind. Dinno SAS makes no guarantees about uptime,
        accuracy of generated CSS across all browsers, or fitness for a particular purpose. Always test generated
        CSS in your target environment.
      </p>

      <h2>Intellectual property</h2>
      <p>
        The site design, tool interfaces, and editorial content are © 2026 Dinno SAS. The source code is available
        on <a href="https://github.com/icysoft/cssgenerators.dev" target="_blank" rel="noopener" style="color:#818cf8;text-decoration:none">GitHub</a>
        under its respective license.
      </p>

      <h2>Governing law</h2>
      <p>
        These terms are governed by French law. Any disputes shall be subject to the exclusive jurisdiction of the
        courts of France.
      </p>

      <h2>Contact</h2>
      <p>
        <a href="mailto:contact@cssgenerators.dev" style="color:#818cf8;text-decoration:none">contact@cssgenerators.dev</a>
      </p>
    </div>
  </main>

  <Footer />
</Layout>
