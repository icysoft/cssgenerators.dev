---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TextShadow from '../components/tools/TextShadow';

const siteUrl = 'https://cssgenerators.dev';
const canonical = `${siteUrl}/css-text-shadow-generator`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'CSS Text Shadow Generator',
      url: canonical,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: 'Free online CSS text-shadow generator with live preview. Create neon, retro, 3D text shadow effects and copy the CSS instantly.',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'CSS Generators', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Text Shadow Generator', item: canonical },
      ],
    },
  ],
};
---
<Layout
  title="CSS Text Shadow Generator — Free Online Tool | cssgenerators.dev"
  description="Generate CSS text-shadow effects online. Neon, retro, 3D presets. Adjust offset, blur, color with live preview. Copy ready-to-use CSS instantly."
  canonical={canonical}
  schema={schema}
>
  <Header />
  <main>
    <div style="padding:32px 40px 16px">
      <div style="font:500 12.5px/1 Inter;color:#6b6b7b;margin-bottom:12px">
        <a href="/" style="color:#8a8a9a;text-decoration:none">Tools</a>
        <span style="color:#3a3a48"> / </span>
        Text Shadow
      </div>
      <h1 style="font:800 34px/1.1 Inter;color:#f2f2f7;margin:0 0 8px;letter-spacing:-0.02em">CSS Text Shadow Generator</h1>
      <p style="font:400 15.5px/1.5 Inter;color:#9b9bab;margin:0 0 32px;max-width:620px">Create neon glows, retro effects, 3D shadows and more. Adjust offset, blur and color — copy production-ready <code style="font-family:'JetBrains Mono',monospace;font-size:14px;background:#1a1a24;padding:2px 6px;border-radius:4px;color:#a5b4fc">text-shadow</code> CSS instantly.</p>
    </div>
    <div style="padding:0 40px 40px">
      <TextShadow client:load />
    </div>

    <div style="padding:40px;border-top:1px solid #1c1c26;max-width:800px">
      <div class="seo-content">
        <h2>How to use the CSS text-shadow generator</h2>
        <p>Select a preset (Neon Blue, Retro, 3D, etc.) or adjust the sliders manually. The horizontal offset moves the shadow left/right, the vertical offset moves it up/down, and blur radius controls how soft the shadow appears. The preview updates instantly.</p>

        <h2>CSS text-shadow syntax</h2>
        <p>The <code>text-shadow</code> property accepts: <code>text-shadow: offset-x offset-y blur-radius color</code>. You can stack multiple shadows by comma-separating them, which is how neon glow effects are created.</p>

        <h3>Neon text shadow effect</h3>
        <p>To create a neon glow, set horizontal and vertical offsets to 0 and use a vivid color like cyan (<code>#22d3ee</code>) or pink (<code>#f472b6</code>). Stack two shadows — one with a small blur and one with a larger blur — for a more realistic glow effect.</p>

        <h3>Retro / 3D text shadow</h3>
        <p>For a retro effect, set a small positive offset on both axes (e.g. 3px 3px) with blur at 0. For a 3D layered effect, stack multiple shadows at incremental offsets using the same or progressively darker color.</p>

        <h3>CSS text-shadow browser compatibility</h3>
        <p><code>text-shadow</code> has 97%+ browser support and works in all modern browsers — Chrome, Firefox, Safari, and Edge — without vendor prefixes.</p>
      </div>
    </div>

    <div style="padding:24px 40px 40px;border-top:1px solid #1c1c26">
      <div style="font:600 15px/1 Inter;color:#e6e6ee;margin-bottom:16px">Other CSS Tools</div>
      <div style="display:flex;flex-wrap:wrap;gap:10px">
        {[
          ['Box Shadow', '/css-box-shadow-generator'],
          ['Drop Shadow', '/css-drop-shadow-generator'],
          ['CSS Filter', '/css-filter-generator'],
          ['CSS Button', '/css-button-generator'],
          ['Flexbox', '/css-flexbox-generator'],
        ].map(([name, href]) => (
          <a href={href} style="padding:8px 16px;border:1px solid #2a2a38;border-radius:8px;background:#16161e;color:#c0c0d0;text-decoration:none;font:500 13px/1 Inter">{name}</a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
