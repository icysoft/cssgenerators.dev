---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Gradient from '../components/tools/Gradient';

const siteUrl = 'https://cssgenerators.dev';
const canonical = `${siteUrl}/css-gradient-generator`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${canonical}#app`,
      name: 'CSS Gradient Generator',
      url: canonical,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: 'Free CSS gradient generator. Create linear, radial and conic gradients with unlimited color stops. Live preview and one-click CSS copy.',
      creator: { '@id': 'https://cssgenerators.dev/#organization' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'CSS Generators', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Gradient Generator', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What are the CSS gradient types?',
          acceptedAnswer: { '@type': 'Answer', text: 'linear-gradient — colors transition along a straight line. Specify angle in degrees (0° = bottom to top, 90° = left to right, 180° = top to bottom). radial-gradient — colors radiate outward from a center point. conic-gradient — colors rotate around a center point, useful for pie charts and color wheels.' },
        },
        {
          '@type': 'Question',
          name: 'What is the CSS gradient syntax?',
          acceptedAnswer: { '@type': 'Answer', text: 'background: linear-gradient(90deg, #6366f1 0%, #22d3ee 100%). Add more color stops by inserting additional color-position pairs: linear-gradient(90deg, #6366f1 0%, #f472b6 50%, #22d3ee 100%).' },
        },
        {
          '@type': 'Question',
          name: 'How do hard color stops work?',
          acceptedAnswer: { '@type': 'Answer', text: 'Create sharp transitions by setting two stops at the same position: linear-gradient(90deg, red 50%, blue 50%). This technique is used for striped backgrounds.' },
        },
        {
          '@type': 'Question',
          name: 'How do you use a CSS gradient as a text fill?',
          acceptedAnswer: { '@type': 'Answer', text: 'Use background: linear-gradient(...); -webkit-background-clip: text; -webkit-text-fill-color: transparent for gradient text effects.' },
        },
      ],
    },
  ],
};
---
<Layout title="CSS Gradient Generator — Free Online Tool | cssgenerators.dev" description="Generate CSS gradients online — linear, radial and conic. Add unlimited color stops, set angle, preview live. Copy background CSS instantly." canonical={canonical} schema={schema}>
  <Header />
  <main>
    <div style="padding:32px 40px 16px">
      <div style="font:500 12.5px/1 Inter;color:#6b6b7b;margin-bottom:12px"><a href="/" style="color:#8a8a9a;text-decoration:none">Tools</a><span style="color:#3a3a48"> / </span>Gradient</div>
      <h1 style="font:800 34px/1.1 Inter;color:#f2f2f7;margin:0 0 8px;letter-spacing:-0.02em">CSS Gradient Generator</h1>
      <p style="font:400 15.5px/1.5 Inter;color:#9b9bab;margin:0 0 32px;max-width:620px">Create <code style="font-family:'JetBrains Mono',monospace;font-size:14px;background:#1a1a24;padding:2px 6px;border-radius:4px;color:#a5b4fc">linear-gradient</code>, <code style="font-family:'JetBrains Mono',monospace;font-size:14px;background:#1a1a24;padding:2px 6px;border-radius:4px;color:#a5b4fc">radial-gradient</code> and <code style="font-family:'JetBrains Mono',monospace;font-size:14px;background:#1a1a24;padding:2px 6px;border-radius:4px;color:#a5b4fc">conic-gradient</code> CSS. Add color stops, set angle, preview live.</p>
    </div>
    <div style="padding:0 40px 40px"><Gradient client:load /></div>
    <div style="padding:40px;border-top:1px solid #1c1c26;max-width:800px">
      <div class="seo-content">
        <h2>What are the CSS gradient types?</h2>
        <p><strong>linear-gradient</strong> — colors transition along a straight line. Specify angle in degrees (0° = bottom to top, 90° = left to right, 180° = top to bottom). <strong>radial-gradient</strong> — colors radiate outward from a center point. <strong>conic-gradient</strong> — colors rotate around a center point (useful for pie charts and color wheels).</p>
        <h2>What is the CSS gradient syntax?</h2>
        <p><code>background: linear-gradient(90deg, #6366f1 0%, #22d3ee 100%)</code>. Add more color stops by inserting additional color-position pairs: <code>linear-gradient(90deg, #6366f1 0%, #f472b6 50%, #22d3ee 100%)</code>.</p>
        <h3>How do hard color stops work?</h3>
        <p>Create sharp transitions by setting two stops at the same position: <code>linear-gradient(90deg, red 50%, blue 50%)</code>. This technique is used for striped backgrounds.</p>
        <h3>How do you use a CSS gradient as a text fill?</h3>
        <p>Use <code>background: linear-gradient(...); -webkit-background-clip: text; -webkit-text-fill-color: transparent</code> for gradient text effects.</p>
      </div>
    </div>
    <div style="padding:24px 40px 0;border-top:1px solid #1c1c26">
      <div style="font:600 15px/1 Inter;color:#e6e6ee;margin-bottom:12px">From the blog</div>
      <a href="/blog/css-gradient-guide" style="display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border:1px solid #2a2a44;border-radius:8px;background:#131320;color:#a5b4fc;font:500 13.5px/1 Inter;text-decoration:none">CSS Gradient Guide: linear, radial and conic →</a>
    </div>
    <div style="padding:24px 40px 40px;border-top:1px solid #1c1c26">
      <div style="font:600 15px/1 Inter;color:#e6e6ee;margin-bottom:16px">Other CSS Tools</div>
      <div style="display:flex;flex-wrap:wrap;gap:10px">
        {[['Box Shadow','/css-box-shadow-generator'],['Filter','/css-filter-generator'],['Button','/css-button-generator'],['Clip Path','/css-clip-path-generator']].map(([name,href])=>(<a href={href} style="padding:8px 16px;border:1px solid #2a2a38;border-radius:8px;background:#16161e;color:#c0c0d0;text-decoration:none;font:500 13px/1 Inter">{name}</a>))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
